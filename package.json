{
  "name": "kubernetes-linter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side linter for Kubernetes Pod manifests",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node scripts/generate-schema.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "codemirror": "^6.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
